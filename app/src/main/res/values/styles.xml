<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Widget.NoteDesu.Button" parent="Widget.Material3.Button.OutlinedButton">
        <item name="fontFamily">@font/zen_old_mincho_medium</item>
        <item name="android:fontFamily">@font/zen_old_mincho_medium</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="strokeColor">@color/crimson</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">4dp</item>
        <item name="backgroundTint">@color/button_bg</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="rippleColor">@color/button_pressed</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TextAppearance.NoteDesu.Story" parent="">
        <item name="fontFamily">@font/zen_old_mincho_medium</item>
        <item name="android:fontFamily">@font/zen_old_mincho_medium</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>
</resources>
