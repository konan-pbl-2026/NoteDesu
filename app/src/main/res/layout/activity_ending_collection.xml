<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#10090D">

    <TextView
        android:id="@+id/collectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ENDING"
        android:textColor="#E3C1C5"
        android:textSize="32sp"
        android:fontFamily="@font/zen_old_mincho_medium"
        android:letterSpacing="0.15"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="45dp"/>

    <TextView
        android:id="@+id/collectionSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="COLLECTION"
        android:textColor="#AD626E"
        android:textSize="17sp"
        android:letterSpacing="0.2"
        app:layout_constraintTop_toBottomOf="@id/collectionTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/endingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#987C82"
        android:textSize="13sp"
        android:fontFamily="@font/zen_old_mincho_medium"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/collectionSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ScrollView
        android:id="@+id/endingScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="false"
        android:layout_marginStart="25dp"
        android:layout_marginEnd="25dp"
        android:layout_marginTop="28dp"
        android:layout_marginBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/endingProgress"
        app:layout_constraintBottom_toTopOf="@id/backButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/endingList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </ScrollView>

    <TextView
        android:id="@+id/backButton"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:gravity="center"
        android:text="TITLE へ戻る"
        android:textColor="#E3C1C5"
        android:textSize="16sp"
        android:fontFamily="@font/zen_old_mincho_medium"
        android:background="@drawable/ending_button"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="25dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>